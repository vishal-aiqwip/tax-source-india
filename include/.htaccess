# These files are only ever reached via require from index.php, never fetched
# directly. Denying them means config.php cannot leak credentials as plain
# source if PHP is ever misconfigured or disabled.

# Apache 2.4+
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
