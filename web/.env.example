# Successor to php/include/config.local.php.
#
# Development: copy to .env.local (gitignored).
# Production:  /etc/taxsourceindia/env, mode 0600, loaded by systemd's
#              EnvironmentFile= — NOT a .env.production inside the deploy
#              tree, which gets copied by rsync and ends up in a tarball.
#
# Never prefix anything here with NEXT_PUBLIC_: that inlines the value into
# the client bundle at build time, permanently. A NEXT_PUBLIC_MAIL_PASSWORD
# is a disclosed credential, not a bug you can quietly fix.

# ---- app ----
PORT=3000
SITE_URL=https://taxsourceindia.com

# ---- enquiry pipeline ----
# Must live OUTSIDE the deploy tree: an in-tree data/ dir is orphaned by any
# future atomic-release deploy, silently splitting the lead history.
# Directory 0750 tsi:tsi, file 0640. Back it up nightly — when SMTP is down
# this file is the only record that anyone enquired.
ENQUIRY_LOG_PATH=/var/lib/taxsourceindia/enquiries.csv
# openssl rand -hex 32. Signs the timing-trap cookie. If unset, the timing
# heuristic is simply skipped and the form still works.
ENQUIRY_TOKEN_SECRET=
ENQUIRY_MIN_SECONDS=3

# ---- mail (was $config['mail']) ----
# Until MAIL_ENABLED is true, enquiries are logged to the CSV only and the
# reason is written to the service log. The visitor still sees the thank-you
# page either way.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=465
# 'ssl' (465, implicit TLS) or 'tls' (587, STARTTLS)
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
# Must be a real mailbox on the sending domain, and the domain's SPF must
# include this relay — otherwise the mail is accepted here and dropped at the
# recipient, with the CSV as the only evidence anyone enquired.
MAIL_FROM=website@taxsourceindia.com
MAIL_FROM_NAME=Tax Source India website
MAIL_TO=info@taxsourceindia.com
MAIL_TO_NAME=Tax Source India
MAIL_SUBJECT=New enquiry from taxsourceindia.com
